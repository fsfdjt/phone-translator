# Set environment variables; this file is an example, not loaded automatically.
GATEWAY_MODE=mock
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Required in twilio mode: exact external HTTPS origin, no path or trailing slash
PUBLIC_BASE_URL=https://your-gateway.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALLOWED_PREFIXES=+880,+60
MAX_CALL_SECONDS=1800
